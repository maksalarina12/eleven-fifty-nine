# ---------------------------------------------------------------------------
# ElevenLabs narration — scripts/tts.mjs
# Copy to .env and fill in. .env is git-ignored.
# ---------------------------------------------------------------------------

# One account:
ELEVENLABS_API_KEY=
# More accounts — the script rotates to the next one when credits run out:
# ELEVENLABS_API_KEY_2=
# ELEVENLABS_API_KEY_3=
# … up to _9, or a single comma-separated line:
# ELEVENLABS_API_KEYS=sk_first,sk_second,sk_third

# Optional labels, used in reports:
# ELEVENLABS_LABEL_2=main channel

# Optional defaults, so --voice / --model can be left off:
ELEVENLABS_VOICE=
ELEVENLABS_MODEL=
