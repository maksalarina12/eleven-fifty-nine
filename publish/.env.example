# Copy to the project root: cp publish/.env.example .env
# Fill only what you use. Never commit this file.

# ---------- caption model ----------
# Any OpenAI-compatible endpoint works: OpenAI, OpenRouter, Groq, Together,
# or a local server (Ollama / LM Studio) at http://localhost:11434/v1
# Without a key the generator falls back to built-in template copy.
LLM_API_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-4o-mini

# ---------- YouTube (OAuth 2.0 refresh token) ----------
# console.cloud.google.com → enable "YouTube Data API v3" → OAuth client (Desktop)
# Scopes: youtube.upload + youtube.readonly (lihat publish/CONNECT.md)
# Testing mode: refresh token mati setelah 7 hari.
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
# private | unlisted | public
YT_PRIVACY=private
YT_CATEGORY=24

# ---------- Instagram (Business/Creator account linked to a Facebook Page) ----------
# developers.facebook.com → app with instagram_content_publish + pages_show_list
IG_USER_ID=
IG_ACCESS_TOKEN=

# ---------- Facebook Page Reels ----------
FB_PAGE_ID=
FB_PAGE_TOKEN=

# ---------- TikTok ----------
# developers.tiktok.com → Content Posting API. Unaudited apps can only post SELF_ONLY.
# Access token ~24 jam; tool ini belum auto-refresh.
TIKTOK_ACCESS_TOKEN=
TIKTOK_PRIVACY=SELF_ONLY

# ---------- X ----------
# OAuth 2.0 user token with tweet.write + media.write + offline.access.
# Access token hanya 2 jam; auto-refresh belum ada.
X_ACCESS_TOKEN=
