# Copy to the project root: cp publish/.env.example .env
# Fill only what you use. Never commit this file.
#
# Easiest path: run `npm run dashboard`, open /connect, paste the app credentials
# there once, press connect. This file is then written for you.

# ---------- caption model ----------
# Any OpenAI-compatible endpoint works: OpenAI, OpenRouter, Groq, Together,
# or a local server (Ollama / LM Studio) at http://localhost:11434/v1
# Without a key the generator falls back to built-in template copy.
LLM_API_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-4o-mini

# ---------- Google / YouTube (OAuth 2.0, written by /connect) ----------
# console.cloud.google.com → enable "YouTube Data API v3" → OAuth client (Desktop)
# Scopes: youtube.upload + youtube.readonly (see publish/CONNECT.md)
# Testing mode: Google expires the refresh token after 7 days.
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
# private | unlisted | public
YT_PRIVACY=private
YT_CATEGORY=24

# ---------- Meta: Instagram + Facebook Page (one app, written by /connect) ----------
# developers.facebook.com → Business app → App settings → Basic
META_APP_ID=
META_APP_SECRET=

# The Page is chosen during /connect; these are the values it fills in.
FB_PAGE_ID=
FB_PAGE_TOKEN=
FB_PAGE_NAME=

# Instagram professional account attached to that Page (same Page token).
IG_USER_ID=
IG_ACCESS_TOKEN=

# ---------- TikTok (written by /connect) ----------
# developers.tiktok.com → Login Kit + Content Posting API.
# Unaudited apps can only post SELF_ONLY. Access token ~24 h; auto-refreshed.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_OPEN_ID=
TIKTOK_EXPIRES_AT=
TIKTOK_PRIVACY=SELF_ONLY

# ---------- X (written by /connect) ----------
# developer.x.com → OAuth 2.0 with tweet.write + media.write + offline.access.
# Access token lasts 2 h; auto-refreshed from the refresh token.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_ACCESS_TOKEN=
X_REFRESH_TOKEN=
X_EXPIRES_AT=
